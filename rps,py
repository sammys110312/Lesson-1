import tkinter as tk
import random

def play(user):
    computer = random.choice(["Rock", "Paper", "Scissors"])

    if user == computer:
        result = "Tie!"
    elif user == "Rock" and computer == "Scissors":
        result = "You win!"
    elif user == "Paper" and computer == "Rock":
        result = "You win!"
    elif user == "Scissors" and computer == "Paper":
        result = "You win!"
    else:
        result = "Computer wins!"

    answer.config(text="Computer: " + computer + "\n" + result)


window = tk.Tk()
window.title("Rock Paper Scissors")

tk.Label(window, text="Rock Paper Scissors").pack()

tk.Button(window, text="Rock",
          command=lambda: play("Rock")).pack()

tk.Button(window, text="Paper",
          command=lambda: play("Paper")).pack()

tk.Button(window, text="Scissors",
          command=lambda: play("Scissors")).pack()

answer = tk.Label(window, text="")
answer.pack()

window.mainloop()